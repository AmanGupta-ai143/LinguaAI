# Optional. MyMemory works without any key. Providing an email raises the free daily quota.
MYMEMORY_EMAIL=
# Optional. Override where the SQLite file is stored (default: data/linguaai.db)
LINGUAAI_DB_PATH=
# Optional. Hosted database (Turso) so history survives restarts on Streamlit Cloud.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Optional. Time zone for timestamps, e.g. Asia/Kolkata (default: server time)
LINGUAAI_TZ=
